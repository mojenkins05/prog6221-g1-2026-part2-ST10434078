<Window x:Class="POEProg6221.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 Wooppaa Cybersecurity Awareness Bot"
        Width="900" Height="700"
        MinWidth="700" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2E"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- Topic Button Style -->
        <Style x:Key="TopicButton" TargetType="Button">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#00D4AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#00D4AA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#00D4AA"/>
                                <Setter Property="Foreground" Value="#1A1A2E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER / ASCII ART SECTION -->
        <Border Grid.Row="0" Background="#0F3460" Padding="15" CornerRadius="0,0,15,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ASCII Art Logo -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="AsciiArtBlock"
                               FontFamily="Consolas"
                               FontSize="11"
                               Foreground="#00D4AA"
                               Text="╔══════════════════════════════════════════╗&#x0a;║    ░ WOOPPAA AWARENESS BOT ░             ║&#x0a;║    🔒 CYBERSECURITY CHATBOT 🔒           ║&#x0a;╚══════════════════════════════════════════╝"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="WelcomeText"
                               FontSize="14"
                               Foreground="#E0E0E0"
                               Margin="0,5,0,0"
                               Text="Welcome! Enter your name to get started."/>
                </StackPanel>

                <!-- Voice Toggle and Status -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="🔊 Voice: " Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                        <CheckBox x:Name="VoiceToggle"
                                  IsChecked="True"
                                  Foreground="White"
                                  VerticalAlignment="Center"
                                  Checked="VoiceToggle_Changed"
                                  Unchecked="VoiceToggle_Changed"/>
                        <TextBlock x:Name="VoiceStatusText"
                                   Text="ON" Foreground="#00D4AA"
                                   FontSize="12" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SentimentIndicator"
                               FontSize="12"
                               Foreground="#FFD700"
                               Text="Mood: 😊 Neutral"
                               HorizontalAlignment="Right"/>
                    <TextBlock x:Name="MemoryIndicator"
                               FontSize="11"
                               Foreground="#B0B0B0"
                               Text="Topics discussed: 0"
                               HorizontalAlignment="Right"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- QUICK TOPIC BUTTONS -->
        <Border Grid.Row="1" Background="#16213E" Padding="8" Margin="0,2,0,0">
            <StackPanel>
                <TextBlock Text="📋 Quick Topics:" Foreground="#B0B0B0" FontSize="12" Margin="5,0,0,5"/>
                <WrapPanel x:Name="TopicButtonsPanel">
                    <Button Content="🔑 Passwords" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="password"/>
                    <Button Content="📧 Phishing" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="phishing"/>
                    <Button Content="🛡️ Scams" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="scam"/>
                    <Button Content="🔐 Privacy" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="privacy"/>
                    <Button Content="🌐 Safe Browsing" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="browsing"/>
                    <Button Content="📱 2FA" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="twofactor"/>
                    <Button Content="🦠 Malware" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="malware"/>
                    <Button Content="📶 Wi-Fi Safety" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="wifi"/>
                    <Button Content="📱 Social Media" Style="{StaticResource TopicButton}" Click="TopicButton_Click" Tag="socialmedia"/>
                    <Button Content="🧠 What I Remember" Style="{StaticResource TopicButton}" Click="MemoryButton_Click" Tag="memory"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- CHAT DISPLAY AREA -->
        <Border Grid.Row="2" Margin="10" CornerRadius="10" Background="#16213E" BorderBrush="#0F3460" BorderThickness="1">
            <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto" Padding="10">
                <StackPanel x:Name="ChatPanel" VerticalAlignment="Bottom">
                    <!-- Chat messages will be added here dynamically -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- NAME INPUT PANEL (shown initially) -->
        <Border x:Name="NameInputPanel" Grid.Row="3" Margin="10,0,10,5" Padding="10" Background="#16213E" CornerRadius="10" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤 Enter your name: " Foreground="#00D4AA" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="NameInput"
                         Style="{StaticResource ModernTextBox}"
                         Width="300"
                         KeyDown="NameInput_KeyDown"
                         VerticalAlignment="Center"/>
                <Button Content="Start Chat"
                        Style="{StaticResource ModernButton}"
                        Margin="10,0,0,0"
                        Click="StartChat_Click"/>
            </StackPanel>
        </Border>

        <!-- MESSAGE INPUT PANEL (shown after name entry) -->
        <Border x:Name="MessageInputPanel" Grid.Row="3" Margin="10,0,10,5" Padding="10" Background="#16213E" CornerRadius="10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageInput"
                         Grid.Column="0"
                         Style="{StaticResource ModernTextBox}"
                         KeyDown="MessageInput_KeyDown"/>

                <Button Grid.Column="1"
                        Content="📤 Send"
                        Style="{StaticResource ModernButton}"
                        Margin="8,0,0,0"
                        Click="SendMessage_Click"/>

                <Button Grid.Column="2"
                        Content="🚪 Quit"
                        Style="{StaticResource ModernButton}"
                        Background="#E74C3C"
                        Margin="8,0,0,0"
                        Click="QuitButton_Click"/>
            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <Border Grid.Row="4" Background="#0F3460" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Grid.Column="0"
                           Text="💡 Type 'help' for topics | 'quit' to exit | 'wooppaa' for fun!"
                           Foreground="#B0B0B0"
                           FontSize="11"/>
                <TextBlock x:Name="TimerText"
                           Grid.Column="1"
                           Text=""
                           Foreground="#B0B0B0"
                           FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>